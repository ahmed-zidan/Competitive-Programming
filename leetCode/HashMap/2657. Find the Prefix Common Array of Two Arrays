class Solution {
public:
    vector<int> findThePrefixCommonArray(vector<int>& A, vector<int>& B) {
        int n1[51] = {0};
        int n2[51] = {0};
        int c = 0;
        vector<int>v(A.size());
        for(int i =0;i<A.size();i++){
            n1[A[i]]++;
            n2[B[i]]++;
            if(A[i] == B[i]) c++;
            else{
                if(n2[A[i]] > 0){
                c++;
            }
            if(n1[B[i]] > 0){
                c++;
            }
            }
            

            v[i] = c;
            
        }

        return v;
    }
};
